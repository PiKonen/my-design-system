{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* .storybook/main.ts and manager.ts are node-context config files just like
     vite.config.ts: node types, no DOM lib. The browser half, preview.tsx, is in
     tsconfig.app.json. */
  "include": ["vite.config.ts", ".storybook/main.ts", ".storybook/manager.ts"]
}
