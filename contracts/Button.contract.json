    "variant": { "type": "enum", "options": ["primary", "secondary"], "default": "primary" },
    "size": { "type": "enum", "options": ["large", "small"], "default": "large" },
    "disabled": { "type": "boolean", "default": false },
    "onClick": { "type": "function", "required": true }
  },

